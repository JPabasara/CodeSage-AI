# Copy to infra/.env for local Docker Compose. Never commit infra/.env.

# Optional read-only token for public GitHub repository metadata and branches.
CODESAGE_GITHUB_TOKEN=

# Asgardeo Backend-for-Frontend configuration.
CODESAGE_ASGARDEO_BASE_URL=https://api.asgardeo.io/t/<your-org>
CODESAGE_ASGARDEO_CLIENT_ID=
CODESAGE_ASGARDEO_CLIENT_SECRET=

# Resend transactional invitation email. Keep the API key out of git.
CODESAGE_RESEND_API_KEY=
CODESAGE_INVITATION_FROM_EMAIL=CodeSage <onboarding@resend.dev>

# Public URL embedded into the browser bundle at build time.
CODESAGE_WEB_API_BASE_URL=http://localhost:8000
