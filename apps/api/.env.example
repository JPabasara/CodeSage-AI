
CODESAGE_DATABASE_URL=postgresql+psycopg://codesage_app:changeme@localhost:5432/codesage

CODESAGE_MIGRATION_DATABASE_URL=postgresql+psycopg://codesage_owner:changeme@localhost:5432/codesage

# Broker configuration.
CODESAGE_REDIS_URL=redis://localhost:6379/0

CODESAGE_GITHUB_TOKEN=
# Seeded into every new workspace at first sign-in. Use a public Java repo.
CODESAGE_DEMO_REPOSITORY_URL=https://github.com/spring-projects/spring-petclinic
CODESAGE_DEMO_REPOSITORY_DEFAULT_BRANCH=main

# ML inference service.
CODESAGE_ML_SERVICE_URL=http://localhost:8001
CODESAGE_ML_TIMEOUT_SECONDS=30

CODESAGE_ASGARDEO_BASE_URL=https://api.asgardeo.io/t/<your-org>
CODESAGE_ASGARDEO_CLIENT_ID=
CODESAGE_ASGARDEO_CLIENT_SECRET=
# Must match the Authorized Redirect URL in the console character for character.
CODESAGE_ASGARDEO_REDIRECT_URI=http://localhost:8000/api/auth/callback
CODESAGE_FRONTEND_BASE_URL=http://localhost:3000

CODESAGE_RESEND_API_KEY=
CODESAGE_INVITATION_FROM_EMAIL=CodeSage <onboarding@resend.dev>
CODESAGE_EMAIL_TIMEOUT_SECONDS=10

# ── The session cookie ──────────────────────────────────────────────────────
CODESAGE_SESSION_COOKIE_NAME=codesage_session
CODESAGE_SESSION_IDLE_MINUTES=60
CODESAGE_SESSION_ABSOLUTE_HOURS=12
CODESAGE_COOKIE_SECURE=false
CODESAGE_COOKIE_DOMAIN=

# ── Signs the short-lived sign-in handshake cookie ──────────────────────────
CODESAGE_SECRET_KEY=generate-a-real-one

# ── CORS: the Next.js origin ────────────────────────────────────────────────
CODESAGE_CORS_ORIGINS=http://localhost:3000

CODESAGE_CLONE_DIR=/var/tmp/codesage-clones

CODESAGE_CK_JAR=/opt/ck/ck.jar

# Optional deterministic PMD detector.
CODESAGE_DETECTOR_PROVIDER=codesage_api.detection.pmd:scan
CODESAGE_PMD_ENABLED=false
CODESAGE_PMD_BIN=/opt/pmd/bin/pmd
CODESAGE_PMD_TIMEOUT_SECONDS=120

CODESAGE_MAX_REPOSITORY_SIZE_MB=500
CODESAGE_MAX_SATD_COMMENTS=5000
# The soft limit ends a scan cleanly (SCAN_TIMED_OUT); the hard limit kills it.
CODESAGE_SCAN_TIME_LIMIT_SECONDS=1860
CODESAGE_SCAN_SOFT_TIME_LIMIT_SECONDS=1800
CODESAGE_GIT_TIMEOUT_SECONDS=300
# Further scans in the same workspace wait in the queue.
CODESAGE_MAX_RUNNING_SCANS_PER_WORKSPACE=1
CODESAGE_SCAN_QUEUE_RETRY_SECONDS=15
# A queued scan nobody picked up within PICKUP, or a waiting one whose worker
# stopped renewing it for HEARTBEAT, is ended so it cannot block its branch.
# HEARTBEAT must be more than twice the retry interval.
CODESAGE_SCAN_PICKUP_SECONDS=10800
CODESAGE_SCAN_QUEUE_HEARTBEAT_SECONDS=120
# Database errors while claiming a slot are retried this many times.
CODESAGE_SCAN_CLAIM_ATTEMPTS=5
# CK, the code-metrics tool, has its own limit inside the scan's.
CODESAGE_CK_TIMEOUT_SECONDS=900
# Soft limit of one profile-score calculation (the hard limit is 30 s more).
CODESAGE_SCORE_TIME_LIMIT_SECONDS=300
# Finished dashboard responses kept in memory by each API process (0 = off).
CODESAGE_RESPONSE_CACHE_MEGABYTES=48

CODESAGE_LOG_LEVEL=INFO
