# Code Sage AI — API/worker environment. Copy to `.env` and fill in.
# Every value here is read through `codesage_api.config.Settings`; nothing in the
# codebase reads os.environ directly.

# ── Database ────────────────────────────────────────────────────────────────
# The application connects as a NON-superuser role so PostgreSQL Row-Level
# Security actually applies to it (SRS DB-2). A superuser silently bypasses every
# policy, which would make tenant isolation look like it works in dev and fail in
# review. See infra/postgres/init/01-init.sql.
CODESAGE_DATABASE_URL=postgresql+psycopg://codesage_app:changeme@localhost:5432/codesage

# A SECOND URL, AND A DIFFERENT ROLE ON PURPOSE — alembic only.
#
# `codesage_app` cannot create or alter tables, and must not be able to: Row-Level
# Security is silently ignored for a table's OWNER, so the application connecting
# as the owner would disable tenant isolation while appearing to work. Migrations
# therefore run as the owner and nothing else does.
#
# Leaving this unset does not fail loudly. Alembic falls back to the default in
# config.py — localhost:5432, password "changeme" — and inside a container that
# surfaces as a connection error that looks like broken networking and is not.
# That was the J0.4 bug (deployment log, Entry 2).
#
# ⚠️ IN PRODUCTION, three things about this line, each of which has cost us time:
#   1. the DIRECT Neon endpoint, never the `-pooler` one — alembic needs a
#      connection of its own; the pooler is for the API's many short requests
#   2. `postgresql+psycopg://`, never bare `postgresql://` — the image ships
#      psycopg 3, and the bare prefix makes SQLAlchemy load psycopg2 (Entry 4)
#   3. end the URL at `?sslmode=require` — a lost `&` before `channel_binding`
#      killed the process on its first query (Entry 4, fault 1)
#
# This is the variable the Railway `api` service's pre-deploy command needs
# (J4.4). Without it on Railway, a merged migration never reaches Neon and the
# live site 500s on the first request touching a new column.
CODESAGE_MIGRATION_DATABASE_URL=postgresql+psycopg://codesage_owner:changeme@localhost:5432/codesage

# ── Broker (SAD §6: API enqueues, workers consume) ──────────────────────────
CODESAGE_REDIS_URL=redis://localhost:6379/0

# Optional read-only token for public GitHub REST metadata and branch requests.
# This is separate from Asgardeo sign-in and must never be committed.
CODESAGE_GITHUB_TOKEN=

# ── ML inference service (SAD §7; called by workers only, never by the API) ──
CODESAGE_ML_SERVICE_URL=http://localhost:8001
# If the ML service does not answer within this budget the scan completes with
# rule-engine findings only — degraded but still a valid snapshot (SAD §11, UC-3 ext. 6a).
CODESAGE_ML_TIMEOUT_SECONDS=30

# ── Sign-in: Asgardeo is the only identity provider ─────────────────────────
# GitHub is configured INSIDE Asgardeo, so this service never runs a GitHub
# OAuth exchange and never holds a GitHub token (SRS FR-1, SEC-17).
# Fill these in from the Asgardeo console — see the work plan (docs/Project Management & Planning/work-plan-and-locked-decisions.md) step 3.10.
CODESAGE_ASGARDEO_BASE_URL=https://api.asgardeo.io/t/<your-org>
CODESAGE_ASGARDEO_CLIENT_ID=
CODESAGE_ASGARDEO_CLIENT_SECRET=
# Must match the Authorized Redirect URL in the console character for character.
CODESAGE_ASGARDEO_REDIRECT_URI=http://localhost:8000/api/auth/callback
CODESAGE_FRONTEND_BASE_URL=http://localhost:3000

# ── The session cookie ──────────────────────────────────────────────────────
CODESAGE_SESSION_COOKIE_NAME=codesage_session
CODESAGE_SESSION_IDLE_MINUTES=60
CODESAGE_SESSION_ABSOLUTE_HOURS=12
# Local development is plain http, so a Secure-only cookie would never be sent.
# This MUST be true anywhere real.
CODESAGE_COOKIE_SECURE=false
# Which hosts the browser sends the session cookie to. Leave EMPTY for local
# development: the API and the frontend are both on localhost, so a host-only
# cookie already reaches both.
#
# In production they are different hosts, so set this to the shared PARENT
# domain, with the leading dot:
#
#   CODESAGE_COOKIE_DOMAIN=.codesageai.dev
#
# Leaving it empty in production means the cookie belongs to api.codesageai.dev
# alone. Sign-in appears to work, then middleware.ts on codesageai.dev cannot
# see the cookie and redirects you back to /login forever.
CODESAGE_COOKIE_DOMAIN=

# ── Signs the short-lived sign-in handshake cookie ──────────────────────────
CODESAGE_SECRET_KEY=generate-a-real-one

# ── CORS: the Next.js origin ────────────────────────────────────────────────
CODESAGE_CORS_ORIGINS=http://localhost:3000

# ── Worker scratch ──────────────────────────────────────────────────────────
# ~2 GB per concurrent scan, released when the scan completes, fails or is cancelled.
CODESAGE_CLONE_DIR=/var/tmp/codesage-clones

# ── Extraction toolchain ────────────────────────────────────────────────────
# CK is a Java jar run as a subprocess — a path, not a pip package. The worker
# image installs it and needs a JRE. v1.0 analyses .java only, because CK is a
# Java-only metric extractor (SRS §2.4).
CODESAGE_CK_JAR=/opt/ck/ck.jar

CODESAGE_LOG_LEVEL=INFO
