# Copy to .env.local and adjust. .env.local is gitignored; this file is not.

# Where the real backend lives. Sign-in and sign-out always go here, whatever the
# mock setting below says — an OIDC flow is a navigation, and a service worker
# cannot intercept one.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# enabled  — mock the data endpoints, pass /api/auth/session through to the real
#            API. The default for local UI work, and what lets you test a real
#            Asgardeo sign-in.
# e2e      — mock the data endpoints AND auth. Playwright sets this for its own
#            server; you rarely need it by hand.
# disabled — no mocking. Only useful with the real API running on :8000.
NEXT_PUBLIC_API_MOCKING=enabled

# Must match the API's CODESAGE_SESSION_COOKIE_NAME.
NEXT_PUBLIC_SESSION_COOKIE_NAME=codesage_session

# Optional: point the rail's Dashboard / Scan History links at a real repository
# instead of the demo fixture id. See src/lib/demo.ts.
# NEXT_PUBLIC_DEMO_REPO_ID=
