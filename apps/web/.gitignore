# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

#playwright
/test-results/
/playwright-report/


# next.js
/.next/
# the isolated build dir Playwright's dev server uses (see next.config.ts)
/.next-e2e/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …except the template. A new teammate cannot guess NEXT_PUBLIC_API_MOCKING's
# three modes from an empty directory.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
